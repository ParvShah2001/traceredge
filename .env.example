# ==============================================================================
# TracerEdge Environment Configuration Example
# Copy this file to .env and configure your variables as needed.
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000

# Optional IndianAPI.in Integration (for detailed fundamentals, peer ratios & market news)
# Obtain your API key from https://indianapi.in
INDIAN_API_KEY=

# Optional 0xramm Stock API Worker URL (for distributed high-speed Yahoo Finance proxying)
# Example: https://your-worker-subdomain.workers.dev
RAM_STOCK_API_URL=

# Python Process Optimizations (recommended for low-memory container environments)
PYTHONUNBUFFERED=1
MALLOC_TRIM_THRESHOLD_=65536
PYTHONMALLOC=malloc
